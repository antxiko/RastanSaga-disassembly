C 0x52E5 fila 7 del teclado, bit 4: STOP
C 0x52EE pulsada: se espera a que se suelte...
C 0x52F7 ...y D5DF cambia: pausa
L 0x52FE cada_dos_cuadros
C 0x52FE dos cuadros
C 0x5303 D910 bit 0: fase acabada
C 0x530A o D17D bit 0 (se borra al mirarlo)
L 0x5313 fase_siguiente
C 0x5313 D5E5 + 1: la fase siguiente
C 0x5318 la 0x11 no se juega: de la 0x10 se pasa a la 0x12
L 0x5321 truco_fases
C 0x5321 con el byte 0x4010 de la cabecera encendido...
C 0x5328 ...fila 0: tecla 7 = fase siguiente...
C 0x5336 (7)
C 0x533A ...tecla 6 = fase anterior
L 0x5342 mira_fin_partida
C 0x5342 D17D bit 1: la partida se acaba
C 0x5349 con el interruptor de pruebas, BS (fila 7 bit 5) tambien la acaba
L 0x535A acaba_partida
C 0x535A D17D bit 6: aviso a la tarea 0
C 0x535F para la tarea 2
L 0x5367 mira_bordes
C 0x5367 donde aparecera el jugador: de entrada, donde esta (D8FC = x, D8FD = y)
C 0x5373 por la izquierda (x < 7)...
C 0x537A ...aparecera a la derecha (x = 0xDA)
C 0x537F columna 0: no hay pantalla a la izquierda
C 0x5386 columna - 1 (D5F0)
C 0x538A y si estaba arriba del todo...
C 0x5392 ...baja a y = 0x23
L 0x539A borde_derecho
C 0x539A por la derecha (x >= 0xE2)...
C 0x53A1 ...aparecera a la izquierda (x = 0x0F)
C 0x53A6 la ultima columna (D5EE)...
C 0x53AA ...no tiene pantalla a la derecha
C 0x53B1 columna + 1
L 0x53C5 borde_inferior
C 0x53C5 por abajo (y >= 0xAF)...
C 0x53CD ...aparecera arriba (y = 0x23)
C 0x53D2 la ultima fila (D5EF)...
C 0x53DD fila + 1 (D5F1)
L 0x53E4 borde_superior
C 0x53E4 por arriba solo si trepa: D90D con los bits 0xC2 a 0x80 o 0x82
C 0x53F1 y en lo alto (y < 0x19)
C 0x53F9 aparecera abajo (y = 0xA5)
C 0x53FE fila 0: no hay pantalla encima
C 0x5405 fila - 1
L 0x540C sigue_en_pantalla
