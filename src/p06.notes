C 0x68c3 cuenta del estado del jugador = a
C 0x68cf cuenta del estado del jugador = a
C 0x68db bit 7 muerto, bit 4 un rato sin mandos = a
C 0x68e3 bit 7 muerto, bit 4 un rato sin mandos = a
C 0x68e9 los mandos: 0 arriba, 1 abajo, 2 izquierda, 3 derecha, 4 boton 1, 5 boton 2 = a
